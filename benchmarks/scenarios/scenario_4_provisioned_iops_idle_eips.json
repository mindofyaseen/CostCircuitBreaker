{
  "scenario_id": "SCENARIO_4",
  "name": "Over-Provisioned IOPS Volume & Idle Elastic IPs",
  "prompt": "Deploy a caching cache node with 10,000 IOPS dedicated volume and a pool of reserved public IP addresses.",
  "budget_limit_usd": 60.0,
  "resources": [
    {
      "Id": "OverprovisionedDisk",
      "Type": "AWS::EC2::Volume",
      "Properties": {
        "VolumeType": "io2",
        "Size": 100,
        "Iops": 10000
      },
      "Quantity": 1
    },
    {
      "Id": "ReservedPublicIpv4Pool",
      "Type": "AWS::EC2::EIP",
      "Properties": {
        "Unattached": true
      },
      "Quantity": 5
    },
    {
      "Id": "CacheHostInstance",
      "Type": "AWS::EC2::Instance",
      "Properties": {
        "InstanceType": "t3.large"
      },
      "Quantity": 1
    }
  ]
}
